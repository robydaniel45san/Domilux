# Copia este archivo a ".env" y ajusta los valores. ".env" NO se sube a git.

# URL de la tienda WooCommerce de la que se descargan los productos (npm run sync-products)
DOMILUX_URL=https://domilux.shop

# Acceso al panel administrativo (/admin). SOLO MOCKUP: estas credenciales viajan dentro del JavaScript del
# navegador, no son seguridad real. Cámbialas si quieres; con backend se sustituye por autenticación de servidor.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=domilux
